<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="540.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.lab10.PrimaryController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
         <menus>
            <Menu mnemonicParsing="false" text="File">
               <items>
                  <MenuItem fx:id="placeOrderMenuItem" mnemonicParsing="false" text="Place Order" />
                  <MenuItem fx:id="clearOrderMenuItem" mnemonicParsing="false" text="Clear Order" />
                  <MenuItem fx:id="exitMenuItem" mnemonicParsing="false" text="Exit" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Edit">
               <items>
                  <MenuItem fx:id="editEntreeMenuItem" mnemonicParsing="false" text="Entrée" />
                  <MenuItem fx:id="editDrinkMenuItem" mnemonicParsing="false" text="Drink" />
                  <MenuItem fx:id="editRequestMenuItem" mnemonicParsing="false" text="Special Request" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Help">
               <items>
                  <MenuItem fx:id="aboutMenuItem" mnemonicParsing="false" text="About" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </top>
   <center>
      <HBox maxHeight="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Entrée Selection" />
                  <ListView fx:id="entreeListView" prefHeight="150.0" prefWidth="270.0" />
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
                  <Label text="Drink Selection " />
                  <RadioButton fx:id="coffeeRadio" mnemonicParsing="false" text="Coffee">
                     <toggleGroup>
                        <ToggleGroup fx:id="drinkGroup" />
                     </toggleGroup></RadioButton>
                  <RadioButton fx:id="teaRadio" mnemonicParsing="false" text="Tea" toggleGroup="$drinkGroup" />
                  <RadioButton fx:id="sodaRadio" mnemonicParsing="false" text="Soda" toggleGroup="$drinkGroup" />
                  <RadioButton fx:id="juiceRadio" mnemonicParsing="false" text="Juice" toggleGroup="$drinkGroup" />
               </children>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </VBox>
         </children>
      </HBox>
   </center>
   <bottom>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <CheckBox fx:id="waterCheckBox" mnemonicParsing="false" text="Request Free Water" />
            <Label text="Special requests" />
            <TextField fx:id="specialRequestsField" prefHeight="25.0" prefWidth="545.0" promptText="e.g. Hold the onion" />
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label fx:id="currentOrderLabel" text="Current Order:" />
                  <Button fx:id="clearOrderButton" mnemonicParsing="false" text="Clear order" />
                  <Button fx:id="placeoderButton" mnemonicParsing="false" text="Place Order" />
               </children>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
